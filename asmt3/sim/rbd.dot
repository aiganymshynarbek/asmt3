digraph rbd {
  rankdir=LR; nodesep=0.15; ranksep=0.35;
  node [shape=box, fontname="DejaVu Sans", fontsize=9, style="filled", fillcolor="#ffffff", color="#6b6a63"];
  edge [arrowhead=none, color="#6b6a63"];
  in [shape=point]; out [shape=point];
  lb [label="LB\n0.9995", fillcolor="#fde8e8", color="#d03b3b"];
  gw [label="API GW\n0.9990", fillcolor="#fde8e8", color="#d03b3b"];
  a1 [label="Auth 1\n0.995"]; a2 [label="Auth 2\n0.995"];
  c1 [label="Course 1\n0.995"]; c2 [label="Course 2\n0.995"];
  r1 [label="Reg 1\n0.995"]; r2 [label="Reg 2\n0.995"];
  d1 [label="DB 1\n0.997"]; d2 [label="DB 2\n0.997"];
  j1 [shape=point]; j2 [shape=point]; j3 [shape=point]; j4 [shape=point]; j5 [shape=point];
  in -> lb -> gw -> j1;
  j1 -> a1 -> j2; j1 -> a2 -> j2;
  j2 -> c1 -> j3; j2 -> c2 -> j3;
  j3 -> r1 -> j4; j3 -> r2 -> j4;
  j4 -> d1 -> j5; j4 -> d2 -> j5;
  j5 -> out;
}
